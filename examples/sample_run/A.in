# ================================================================================
#  NanoCut v0.1.0  -  deck A (build + equilibrate)  -  generated 2026-10-10
#  experiment : cut_SiC_R10_d10_preview
#  workpiece  : 3C-SiC (cubic silicon carbide, zinc-blende), a0 = 4.3667 A, 41x41x4 cells = 17.90 x 17.90 x 1.747 nm (54452 atoms)
#  tool       : Diamond (C), wedge, rake 0.0 deg, clearance 10.0 deg, edge radius 3.571 nm, 12.4272 x 12.4272 nm, deformable (43363 atoms)
#  process    : depth 1.31001 nm, gap 0.0 nm, speed 200.0 m/s = 2.0000 A/ps, cut length 0.3 nm -> 3000 steps of 0.5 fs
#  potential  : Tersoff Si-C (1994, smooth cutoffs)  [J. Tersoff, Phys. Rev. B 49, 16349 (1994); file DATE 2011-05-03]
#  units metal: A, ps, eV, K, g/mol, bar; velocity A/ps; force eV/A (x1.602 = nN)
#  layers via mol tag: 1 tool mobile, 2 tool thermostat, 3 tool fixed, 4 wp mobile, 5 wp thermostat, 6 wp fixed
# ================================================================================

units           metal
dimension       3
boundary        s s p    # x,y shrink-wrapped; z (width) periodic
atom_style      atomic

# ---------------- simulation box (shrink-wrapped in x,y; exact period in z) ----------------
region          whole block -5.000000 300.236700 -5.000000 295.206600 0.000000 17.466800 units box
create_box      3 whole

# ---------------- tool: Diamond (C) (type 1) ----------------
lattice         diamond 3.571 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1 origin 0.0 0.0 0.4
region tool_block block 170.964700 295.236700 165.934600 290.206600 INF INF units box
region tool_rake  plane 170.964700 201.644600 0.0 1.000000 -0.000000 0.0 units box
region tool_flank plane 212.875676 166.477115 0.0 -0.173648 0.984808 0.0 units box
region tool_kA plane 206.674700 201.644600 0.0 -0.000000 -1.000000 0.0 units box
region tool_kB plane 206.674700 201.644600 0.0 -0.984808 -0.173648 0.0 units box
region tool_corner_out intersect 2 tool_kA tool_kB side out
region tool_body intersect 4 tool_block tool_rake tool_flank tool_corner_out
region tool_edge cylinder z 206.674700 201.644600 35.710000 INF INF units box
region cut_tool union 2 tool_body tool_edge
create_atoms    1 region cut_tool
group           gpCTall region cut_tool
region ctTop block 170.964700 295.236700 279.493600 290.206600 INF INF units box
region ctxEnd block 284.523700 295.236700 165.934600 290.206600 INF INF units box
region ctTSbottom block 170.964700 284.523700 268.780600 279.493600 INF INF units box
region ctTSxEnd block 273.810700 284.523700 165.934600 279.493600 INF INF units box
region ctbound union 2 ctTop ctxEnd
region ctTSbound union 2 ctTSbottom ctTSxEnd
group           gpCTbd region ctbound
group           gpCTts0 region ctTSbound
group           gpCTtsbd subtract gpCTts0 gpCTbd    # disjoint from the fixed layer
group           gpCTts0 delete
group           gpCTmob subtract gpCTall gpCTbd gpCTtsbd
print           "tool created"

# ---------------- workpiece: 3C-SiC (cubic silicon carbide, zinc-blende) (types 2=Si, 3=C) ----------------
region          workpiece block 0.0 179.034700 0.0 179.034700 INF INF units box
lattice         fcc 4.3667 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1 origin 0.0 0.0 0.0
create_atoms    2 region workpiece
lattice         fcc 4.3667 orient x 1 0 0 orient y 0 1 0 orient z 0 0 1 origin 0.25 0.25 0.25
create_atoms    3 region workpiece
region wpbottom block 0.000000 179.034700 0.000000 21.833500 INF INF units box
region wpxEnd block 0.000000 21.833500 0.000000 179.034700 INF INF units box
region wpTSbottom block 21.833500 179.034700 21.833500 43.667000 INF INF units box
region wpTSxEnd block 21.833500 43.667000 21.833500 179.034700 INF INF units box
region wpbound union 2 wpbottom wpxEnd
region wpTSbound union 2 wpTSbottom wpTSxEnd
group           gpWPall region workpiece
group           gpWPbd region wpbound
group           gpWPts0 region wpTSbound
group           gpWPtsbd subtract gpWPts0 gpWPbd    # disjoint from the fixed layer
group           gpWPts0 delete
group           gpWPmob subtract gpWPall gpWPbd gpWPtsbd
print           "workpiece created"

mass            1 12.011    # C
mass            2 28.0855    # Si
mass            3 12.011    # C

# ---------------- force field ----------------
pair_style      tersoff
pair_coeff      * * SiC_1994.tersoff C Si C    # type order: 1=C 2=Si 3=C

# ---------------- layer tags (survive the restart) ----------------
fix             13 all property/atom mol
set             group gpCTmob mol 1
set             group gpCTtsbd mol 2
set             group gpCTbd mol 3
set             group gpWPmob mol 4
set             group gpWPtsbd mol 5
set             group gpWPbd mol 6

# ---------------- equilibration ----------------
group           gpWPeq union gpWPmob gpWPtsbd
group           gpCTeq union gpCTmob gpCTtsbd
group           mobile_eq union gpWPeq gpCTeq
velocity        mobile_eq create 300.0 102456 dist uniform mom yes rot yes
compute         Twp gpWPmob temp
compute         Tct gpCTmob temp
fix             holdWP gpWPbd move linear 0.0 0.0 0.0 units box    # fixed boundary layer
fix             holdCT gpCTbd move linear 0.0 0.0 0.0 units box
fix             eqWP gpWPeq nvt temp 300.0 300.0 0.05
fix             eqCT gpCTeq nvt temp 300.0 300.0 0.05
reset_timestep  0
timestep        0.0005    # ps (0.5 fs)
fix             bal all balance 100 0.9 shift xy 10 1.05

thermo_style    custom step time temp c_Twp c_Tct pe ke press cpuremain
thermo          100
thermo_modify   flush yes

dump            eq all custom 1000000000 cut_SiC_R10_d10_preview_equil.*.lammpstrj id type mol x y z vx vy vz
dump_modify     eq element C Si C
restart         1000000000 cut_SiC_R10_d10_preview_equil.*.restart
run             600    # 0.3 ps
write_restart   cut_SiC_R10_d10_preview_A.restart
print           "A done"
